---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import SkillsRadar from "../components/home/SkillsRadar.astro";
import TerminalHero from "../components/home/TerminalHero.astro";
import Reveal from "../components/ui/Reveal.astro";
const posts = await getCollection("blog");
const projects = await getCollection("projects");
const staticData = (await getCollection("staticData"))[0];
const { pageTitle, pageDescription, OGImage } = staticData.data;

const postCount = posts.length;
const projectCount = projects.length;
const featuredProject = projects.find(p => p.slug.includes("dbt")) || projects[0];
const latestPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 2);
---

<Layout pageTitle={pageTitle} description={pageDescription} ogimage={{ alt: OGImage.alt, url: OGImage.url }}>
  
  <main class="min-h-screen bg-background px-4 py-12 md:px-8 max-w-7xl mx-auto transition-colors duration-300">
    <header class="mb-12 grid md:grid-cols-2 gap-8 items-center">
  <div class="text-center md:text-left space-y-4">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight">
      Hi, I'm <span class="text-accent">Ricard</span>.
    </h1>
    <p class="text-xl text-text-secondary leading-relaxed">
      Analytics Engineer and Business Analyst. I build scalable data pipelines, automate quality checks, and turn complex data into actionable business insights.
    </p>
    <div class="flex gap-4 justify-center md:justify-start pt-2">
      <a href="/projects" class="px-6 py-2.5 bg-accent text-background font-semibold rounded-lg hover:bg-accent/90 transition-all">View Projects</a>
      <a href="/about-me" class="px-6 py-2.5 border border-white/10 rounded-lg hover:bg-white/5 transition-all">More About Me</a>
    </div>
  </div>
  <!-- The Clever Hook -->
  <TerminalHero />
</header>
    <!-- Grid: minmax ensures rows grow if content needs it, preventing cut-off text -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 auto-rows-[minmax(220px,auto)]">
      
      <!-- 1. Intro (2 cols) -->
      <div class="bento-card group bg-surface border border-white/10 dark:border-white/10 border-black/10 rounded-2xl p-6 md:col-span-2 lg:col-span-2 flex flex-col justify-center">
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-3">
          Hi, I'm <span class="text-accent">Ricard</span>.
        </h1>
        <p class="text-text-secondary max-w-md leading-relaxed">
          Analytics Engineer & Data Professional. I build scalable data pipelines, automate quality checks, and turn complex data into actionable insights.
        </p>
      </div>
      <Reveal delay={100}>  
      <!-- 2. Stats (1 col) -->
      <div class="bento-card group bg-surface border border-white/10 dark:border-white/10 border-black/10 rounded-2xl p-6 lg:col-span-1 flex flex-col justify-center">
        <h3 class="text-text-secondary text-[10px] font-bold uppercase tracking-widest mb-4">By the Numbers</h3>
        <div class="grid grid-cols-2 gap-4">
          <div><div class="text-2xl font-mono font-bold text-accent">5+</div><div class="text-[10px] text-text-secondary uppercase mt-1">Years Exp</div></div>
          <div><div class="text-2xl font-mono font-bold text-accent">4</div><div class="text-[10px] text-text-secondary uppercase mt-1">Certs</div></div>
          <div><div class="text-2xl font-mono font-bold text-accent">{postCount}</div><div class="text-[10px] text-text-secondary uppercase mt-1">Posts</div></div>
          <div><div class="text-2xl font-mono font-bold text-accent">{projectCount}</div><div class="text-[10px] text-text-secondary uppercase mt-1">Projects</div></div>
        </div>
      </div>
      </Reveal>
      <!-- 3. Skills Radar (1 col, 2 rows tall) -->
      <Reveal delay={200}>  
      <div class="bento-card group bg-surface border border-white/10 dark:border-white/10 border-black/10 rounded-2xl p-6 lg:col-span-1 lg:row-span-2 flex flex-col items-center justify-center">
        <h3 class="text-text-secondary text-[10px] font-bold uppercase tracking-widest mb-2 w-full text-left">Core Competencies</h3>
        <div class="flex-1 flex items-center justify-center w-full py-4">
          <SkillsRadar />
        </div>
      </div>
      </Reveal>
      <!-- 4. Featured Project (2 cols) -->
       
      {featuredProject && (
        <a href={`/projects/${featuredProject.slug}`} class="bento-card group bg-surface border border-white/10 dark:border-white/10 border-black/10 rounded-2xl p-6 md:col-span-2 lg:col-span-2 transition-all hover:border-accent/40">
          
          <div class="flex flex-col h-full justify-between">
            <Reveal delay={100}>
            <div>
              <div class="flex justify-between items-start mb-3">
                <span class="text-[10px] font-mono font-bold text-accent bg-accent/10 px-2 py-1 rounded uppercase tracking-wider">Featured Project</span>
                <svg class="w-5 h-5 text-text-secondary group-hover:text-accent group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
              </div>
              <h3 class="text-xl font-bold mb-2 group-hover:text-accent transition-colors">{featuredProject.data.title}</h3>
              <p class="text-text-secondary text-sm mb-4 line-clamp-2">{featuredProject.data.description}</p>
            </div>
            </Reveal>
            <Reveal delay={300}>
            <div class="flex flex-wrap gap-2">
              {featuredProject.data.stack.map((tech: string) => (
                <span class="text-[10px] font-mono bg-white/5 dark:bg-white/5 bg-black/5 text-text-secondary px-2 py-1 rounded-md border border-white/10 dark:border-white/10 border-black/10">{tech}</span>
              ))}
            </div>
            </Reveal>
          </div>
          
        </a>
      )}

<Reveal delay={400}>
      <!-- 5. Certifications (1 col) -->
      <div class="bento-card group bg-surface border border-white/10 dark:border-white/10 border-black/10 rounded-2xl p-6 lg:col-span-1">
        <h3 class="text-text-secondary text-[10px] font-bold uppercase tracking-widest mb-3">Certifications</h3>
        <div class="space-y-2">
          <div class="flex items-center gap-3 p-2 rounded-lg bg-white/5 dark:bg-white/5 bg-black/5 border border-white/10 dark:border-white/10 border-black/10 hover:border-accent/40 transition-colors">
            <div class="w-8 h-8 bg-accent/20 rounded flex items-center justify-center text-accent font-bold text-[10px]">PSAA</div>
            <div class="text-xs font-medium text-text-primary">Professional Data</div>
          </div>
          <div class="flex items-center gap-3 p-2 rounded-lg bg-white/5 dark:bg-white/5 bg-black/5 border border-white/10 dark:border-white/10 border-black/10 hover:border-accent/40 transition-colors">
            <div class="w-8 h-8 bg-accent/20 rounded flex items-center justify-center text-accent font-bold text-[10px]">GCP</div>
            <div class="text-xs font-medium text-text-primary">Cloud Engineer</div>
          </div>
        </div>
      </div>
</Reveal>
<Reveal delay={500}>
      <!-- 7. Tech Stack (2 cols, 2 rows tall to balance the grid) -->
      <div class="bento-card group bg-surface border border-white/10 dark:border-white/10 border-black/10 rounded-2xl p-6 md:col-span-2 lg:col-span-2 lg:row-span-2 flex flex-col justify-center">
        <h3 class="text-text-secondary text-[10px] font-bold uppercase tracking-widest mb-4">Tech Stack</h3>
        <div class="flex flex-wrap gap-2">
          {['Python', 'SQL', 'dbt', 'BigQuery', 'Airflow', 'Git', 'Docker', 'Looker', 'GCP'].map(tech => (
            <span class="px-3 py-2 text-xs font-mono rounded-md bg-white/5 dark:bg-white/5 bg-black/5 border border-white/10 dark:border-white/10 border-black/10 text-text-secondary group-hover:border-accent/40 group-hover:text-accent transition-colors cursor-default">{tech}</span>
          ))}
        </div>
        <div class="mt-auto pt-6 border-t border-white/10 dark:border-white/10 border-black/10">
          <p class="text-sm text-text-secondary">Open to new opportunities in Data Engineering and Analytics.</p>
          <a href="mailto:ricard.alcarazm@gmail.com" class="inline-block mt-3 text-sm font-bold text-accent hover:underline">Get in touch →</a>
        </div>
      </div>
</Reveal>
<Reveal delay={600}>
      <!-- 6. Latest Posts (2 cols, 2 rows tall to prevent clipping) -->
      <div class="bento-card group bg-surface border border-white/10 dark:border-white/10 border-black/10 rounded-2xl p-6 md:col-span-2 lg:col-span-2 lg:row-span-2">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-text-secondary text-[10px] font-bold uppercase tracking-widest">Latest Writings</h3>
          <a href="/blog" class="text-[10px] font-mono text-accent hover:underline">View all →</a>
        </div>
        <div class="grid grid-cols-1 gap-3">
          {latestPosts.map((post) => (
            <a href={`/blog/${post.slug}`} class="block p-4 rounded-xl bg-white/5 dark:bg-white/5 bg-black/5 border border-white/10 dark:border-white/10 border-black/10 hover:border-accent/40 transition-colors group/post">
              <div class="text-[10px] text-text-secondary mb-1 font-mono">{post.data.pubDate.toLocaleDateString()}</div>
              <h4 class="font-bold text-base mb-1.5 group-hover/post:text-accent transition-colors line-clamp-1">{post.data.title}</h4>
              <p class="text-xs text-text-secondary line-clamp-2 leading-relaxed">{post.data.description}</p>
            </a>
          ))}
        </div>
      </div>
</Reveal>

    </div>
  </main>

  <!-- SPOTLIGHT EFFECT -->
  <script>
    document.querySelectorAll('.bento-card').forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  </script>

  <style>
    .bento-card {
      position: relative;
      /* REMOVED overflow: hidden so SVG labels don't get clipped */
      transition: border-color 0.3s ease, transform 0.2s ease;
    }
    .bento-card:hover {
      transform: translateY(-2px);
    }
    /* Spotlight Glow: Added rounded-2xl so it doesn't bleed outside the card corners */
    .bento-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      border-radius: 1rem; /* Matches rounded-2xl */
      background: radial-gradient(
        600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(66, 133, 244, 0.08),
        transparent 40%
      );
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
      z-index: 1;
    }
    .bento-card:hover::before {
      opacity: 1;
    }
    .bento-card > * {
      position: relative;
      z-index: 2;
    }
  </style>
</Layout>