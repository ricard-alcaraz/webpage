---
import { getCollection } from 'astro:content';
import Layout from "../../../layouts/Layout.astro";
import ListPosts from "../../../components/blog/ListPosts.astro";

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const languages = [...new Set(posts.flatMap(post => post.data.languages || []))];
  
  return languages.map(lang => ({
    params: { tech: lang.toLowerCase() },
    props: { langName: lang, posts: posts.filter(p => (p.data.languages || []).includes(lang)) }
  }));
}

const { langName, posts } = Astro.props;
---

<Layout pageTitle={`${langName} | Blog`} description={`Posts about ${langName}`}>
  <main class="min-h-screen bg-background text-text-primary px-4 py-12 md:px-8 max-w-5xl mx-auto transition-colors duration-300">
    
    <div class="mb-12">
      <a href="/blog" class="inline-flex items-center gap-2 text-sm font-mono text-text-secondary hover:text-accent transition-colors mb-4">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Back to Blog
      </a>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-2">
        <span class="text-accent">{langName}</span>
      </h1>
      <p class="text-text-secondary">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
    </div>

    <ListPosts all={true} allPosts={posts} />
  </main>
</Layout>