---
import Layout from "../../../layouts/Layout.astro";
import Languages from "../../../components/blog/Languages.astro";
import Heading from "../../../components/ui/Heading.astro";
import { getCollection } from "astro:content";

// 1. Fetch all blog posts
const allPosts = await getCollection("blog");
const pageTitle = "Technologies";
---

<Layout pageTitle={pageTitle}>
  <section class="py-8">
    <div class="flex flex-col gap-8 max-w-3xl mx-auto">
      <Heading text="Technologies" />
      <!-- 2. Pass 'allPosts' to the component, NOT 'languages' -->
      <Languages allPosts={allPosts} />
    </div>
  </section>
</Layout>