---
// src/pages/about-me.astro
import Layout from "../layouts/Layout.astro";

const pageTitle = "About Me | Ricard Alcaraz";
const pageDescription = "Analytics Engineer & Data Professional bridging the gap between complex data infrastructure and real business value.";
const profileImage = "/images/profile_photo.webp";
---

<Layout pageTitle={pageTitle} description={pageDescription}>
  <main class="min-h-screen bg-background text-text-primary">
    
    <!-- SECTION 1: Split Hero (Photo + Intro) -->
    <section class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:px-8">
      <div class="grid md:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Left: Profile Photo with subtle high-tech framing -->
        <div class="md:col-span-5 relative group">
          <div class="absolute -inset-1 bg-gradient-to-br from-accent/20 to-transparent rounded-2xl blur opacity-50 group-hover:opacity-75 transition duration-500"></div>
          <div class="relative aspect-[4/5] rounded-2xl overflow-hidden border border-white/10 bg-surface">
            <img 
              src={profileImage} 
              alt="Ricard Alcaraz Mancebo" 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              width="400"
              height="500"
              loading="eager"
            />
            <!-- Floating Badge -->
            <div class="absolute bottom-4 left-4 right-4 bg-background/90 backdrop-blur-md border border-white/10 rounded-xl p-4 shadow-xl">
              <div class="flex items-center gap-3">
                <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
                <span class="text-sm font-medium text-text-primary">Available for new connections</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Narrative Intro -->
        <div class="md:col-span-7 space-y-6">
          <div>
            <h2 class="text-accent font-mono text-sm tracking-wider uppercase mb-2">About Me</h2>
            <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-text-primary mb-4">
              Ricard Alcaraz Mancebo
            </h1>
            <p class="text-xl md:text-2xl text-text-secondary font-light leading-relaxed">
              Analytics Engineer and Business Analyst building scalable data pipelines and turning complex data into actionable business insights.
            </p>
          </div>

          <div class="space-y-4 text-text-secondary leading-relaxed">
            <p>
              I have experience as an Analytics Engineer and Business Analyst. I have owned the full data lifecycle: ingesting raw data from GCS and BigQuery, building transformation models in dbt, orchestrating pipelines with Airflow, and delivering results as Looker dashboards that the business actually uses.
            </p>
            <p>
              What makes my background different is the combination of a <span class="text-accent font-semibold">Computer Engineering</span> degree with a <span class="text-accent font-semibold">Master's in Management & Business Economics</span>. This means I don't just build pipelines; I think about why they matter to the people relying on the data. In the banking sector, reliability and governance are part of the job.
            </p>
          </div>

          <div class="flex flex-wrap gap-4 pt-4">
            <a href="mailto:ricard.alcarazm@gmail.com" class="px-6 py-3 bg-accent text-background font-semibold rounded-lg hover:bg-accent/90 transition-all hover:shadow-[0_0_20px_-5px_rgba(var(--accent-rgb),0.5)]">
              Get in Touch
            </a>
            <a href="https://www.linkedin.com/in/ricard-alcaraz-mancebo/" class="px-6 py-3 border border-white/10 rounded-lg hover:bg-white/5 hover:border-white/20 transition-all font-medium" target="_blank" rel="noopener noreferrer">
              Contact me on LinkedIn
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: Clean Vertical Timeline (Education & Experience) -->
    <section class="bg-surface/30 border-y border-white/5">
      <div class="max-w-4xl mx-auto px-6 py-16 md:px-8">
        <h3 class="text-2xl font-bold mb-10 flex items-center gap-3">
          <span class="w-8 h-1 bg-accent rounded-full"></span>
          Journey & Education
        </h3>
        
        <div class="space-y-10 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-white/10 before:to-transparent">
          
          <!-- Item 1 -->
          <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
            <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white/10 bg-surface shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10">
              <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] bg-background border border-white/5 rounded-xl p-6 shadow-sm hover:border-accent/30 transition-colors">
              <div class="flex items-center justify-between space-x-2 mb-1">
                <span class="font-bold text-text-primary">Analytics Engineer</span>
                <time class="font-mono text-xs text-accent bg-accent/10 px-2 py-1 rounded">2023 - 2026</time>
              </div>
              <div class="text-sm text-text-secondary mb-2">Seidor OpenTrends (CaixaBank Tech), Barcelona</div>
              <p class="text-sm text-text-secondary">Own the full data lifecycle: GCS, BigQuery, dbt, Airflow, and Looker dashboards.</p>
            </div>
          </div>

          <!-- Item 2 -->
          <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group">
            <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white/10 bg-surface shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10">
              <svg class="w-4 h-4 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path></svg>
            </div>
            <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] bg-background border border-white/5 rounded-xl p-6 shadow-sm hover:border-accent/30 transition-colors">
              <div class="flex items-center justify-between space-x-2 mb-1">
                <span class="font-bold text-text-primary">MSc Management, Organization and Business Economics</span>
                <time class="font-mono text-xs text-text-secondary bg-white/5 px-2 py-1 rounded">2022 - 2023</time>
              </div>
              <div class="text-sm text-text-secondary">Universitat Autonoma de Barcelona & Universidad Publica de Navarra</div>
            </div>
          </div>

          <!-- Item 3 -->
          <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group">
            <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white/10 bg-surface shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10">
              <svg class="w-4 h-4 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] bg-background border border-white/5 rounded-xl p-6 shadow-sm hover:border-accent/30 transition-colors">
              <div class="flex items-center justify-between space-x-2 mb-1">
                <span class="font-bold text-text-primary">Developer/R&D Team Leader</span>
                <time class="font-mono text-xs text-text-secondary bg-white/5 px-2 py-1 rounded">2017 - 2021</time>
              </div>
              <div class="text-sm text-text-secondary mb-2">Illimit Comunicacions S.L., Terrassa</div>
              <p class="text-sm text-text-secondary">Planned and developed a proof-of-concept product based on Blockchain technology.</p>

            </div>
          </div>

          <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group">
            <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white/10 bg-surface shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10">
              <svg class="w-4 h-4 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path></svg>
            </div>
            <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] bg-background border border-white/5 rounded-xl p-6 shadow-sm hover:border-accent/30 transition-colors">
              <div class="flex items-center justify-between space-x-2 mb-1">
                <span class="font-bold text-text-primary">BSc Computer Engineering</span>
                <time class="font-mono text-xs text-text-secondary bg-white/5 px-2 py-1 rounded">2017 - 2021</time>
              </div>
              <div class="text-sm text-text-secondary">Universitat Autonoma de Barcelona</div>
            </div>
          </div>

          <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group">
            <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white/10 bg-surface shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10">
              <svg class="w-4 h-4 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] bg-background border border-white/5 rounded-xl p-6 shadow-sm hover:border-accent/30 transition-colors">
              <div class="flex items-center justify-between space-x-2 mb-1">
                <span class="font-bold text-text-primary">Web Developer / IT Technician</span>
                <time class="font-mono text-xs text-text-secondary bg-white/5 px-2 py-1 rounded">2017 - 2018</time>
              </div>
              <div class="text-sm text-text-secondary mb-2">Aser Reparapcs, Badia Del Valles</div>
              <p class="text-sm text-text-secondary">Designed and developed web applications, also provided IT support.</p>

            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: Stack & Certifications (Clean, structured, no bento gaps) -->
    <section class="max-w-7xl mx-auto px-6 py-16 md:px-8">
      <div class="grid md:grid-cols-2 gap-12">
        
        <!-- Tech Stack -->
        <div>
          <h3 class="text-2xl font-bold mb-6 flex items-center gap-3">
            <span class="w-8 h-1 bg-accent rounded-full"></span>
            Technological Stack
          </h3>
          <p class="text-text-secondary mb-6">
            I work across the modern data stack, with a strong focus on Google Cloud Platform, orchestration, and transformation.
          </p>
          <div class="flex flex-wrap gap-3">
            {["Google Cloud Platform (GCP)", "BigQuery", "dbt", "Apache Airflow", "Python", "Looker", "Git", "Jenkins", "Docker"].map((tech) => (
              <span class="px-4 py-2 text-sm font-medium bg-surface border border-white/10 rounded-lg text-text-secondary hover:border-accent/50 hover:text-accent hover:bg-accent/5 transition-all cursor-default">
                {tech}
              </span>
            ))}
          </div>
        </div>

        <!-- Certifications -->
        <div>
          <h3 class="text-2xl font-bold mb-6 flex items-center gap-3">
            <span class="w-8 h-1 bg-accent rounded-full"></span>
            Certifications
          </h3>
          <div class="space-y-4">
            {[
              { name: "Practical SOC Analyst Associate (PSAA)", issuer: "TCM Security", date: "Sep 2025" },
              { name: "Google Cloud Associate Cloud Engineer", issuer: "Google", date: "Jun 2024" },
              { name: "Data Build Tool + BigQuery Bootcamp", issuer: "Upgrade", date: "Feb 2024" },
              { name: "Google Project Management", issuer: "Google", date: "Jun 2023" }
            ].map((cert) => (
              <div class="flex items-start gap-4 p-4 rounded-xl bg-surface border border-white/5 hover:border-accent/30 transition-all group">
                <div class="mt-1 w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center text-accent group-hover:bg-accent/20 transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <div>
                  <h4 class="font-semibold text-text-primary group-hover:text-accent transition-colors">{cert.name}</h4>
                  <p class="text-sm text-text-secondary">{cert.issuer} • {cert.date}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- SECTION 4: Simple Call to Action -->
    <section class="border-t border-white/5 bg-surface/30">
      <div class="max-w-3xl mx-auto px-6 py-16 text-center">
        <h3 class="text-2xl md:text-3xl font-bold mb-4">Let's build something reliable.</h3>
        <p class="text-text-secondary mb-8">
          I'm always open to connecting with people working in analytics engineering, data engineering, cloud infrastructure, business analytics, or anyone building something interesting with GCP and AI.
        </p>
        <a href="mailto:your.email@example.com" class="inline-flex items-center gap-2 px-6 py-3 bg-accent text-background font-semibold rounded-lg hover:bg-accent/90 transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          Send me an email
        </a>
      </div>
    </section>

  </main>
</Layout>