---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const sortedProjects = projects.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout pageTitle="Projects" description="My data engineering and analytics projects">
  <main class="min-h-screen bg-background text-text-primary px-4 py-12 md:px-8 max-w-6xl mx-auto transition-colors duration-300">
    
    <!-- Header -->
    <div class="mb-12 text-center md:text-left">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">
        Selected <span class="text-accent">Projects</span>
      </h1>
      <p class="text-xl text-text-secondary max-w-2xl">
        Deep dives into data pipelines, automation tools, and analytics engineering case studies. 
        Each project represents a real-world problem solved with scalable architecture.
      </p>
    </div>
    
    <!-- Fancy Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedProjects.map((project) => (
        <a href={`/projects/${project.slug}`} class="fancy-project-card group relative block p-6 rounded-2xl bg-surface border border-white/10 dark:border-white/10 border-black/10 transition-all duration-300 hover:-translate-y-1">
          <!-- Top Accent Glow Line -->
          <div class="absolute top-0 left-6 right-6 h-px bg-gradient-to-r from-transparent via-accent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          
          <div class="flex justify-between items-start mb-4">
            <div class="flex flex-wrap gap-2">
              {project.data.tags.slice(0, 2).map((tag: string) => (
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider bg-accent/10 text-accent px-2 py-1 rounded">{tag}</span>
              ))}
            </div>
            <svg class="w-5 h-5 text-text-secondary group-hover:text-accent group-hover:translate-x-1 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </div>
          
          <h2 class="text-xl font-bold mb-3 group-hover:text-accent transition-colors duration-300">{project.data.title}</h2>
          <p class="text-text-secondary text-sm mb-6 line-clamp-3 leading-relaxed">{project.data.description}</p>
          
          <div class="flex flex-wrap gap-2 mt-auto">
            {project.data.stack.slice(0, 4).map((tech: string) => (
              <span class="text-[10px] font-mono bg-white/5 dark:bg-white/5 bg-black/5 text-text-secondary px-2.5 py-1 rounded-md border border-white/10 dark:border-white/10 border-black/10 group-hover:border-accent/30 transition-colors">
                {tech}
              </span>
            ))}
            {project.data.stack.length > 4 && (
              <span class="text-[10px] font-mono text-text-secondary px-2.5 py-1">+{project.data.stack.length - 4}</span>
            )}
          </div>
        </a>
      ))}
    </div>
  </main>

  <!-- Spotlight Effect Script -->
  <script>
    document.querySelectorAll('.fancy-project-card').forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  </script>

  <style>
    .fancy-project-card {
      position: relative;
      overflow: hidden;
    }
    .fancy-project-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      border-radius: 1rem;
      background: radial-gradient(
        600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(66, 133, 244, 0.06),
        transparent 40%
      );
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
      z-index: 0;
    }
    .fancy-project-card:hover::before {
      opacity: 1;
    }
    .fancy-project-card > * {
      position: relative;
      z-index: 1;
    }
  </style>
</Layout>