<script>
  // 1. Match the class generated by your remark plugin: 'mermaid-wrapper'
  const wrappers = document.querySelectorAll('.mermaid-wrapper');

  if (wrappers.length > 0) {
    import('mermaid').then(async ({ default: mermaid }) => {
      const getCurrentTheme = () => {
        const html = document.documentElement;
        if (html.classList.contains('dark')) return 'dark';
        const attr = html.getAttribute('data-theme');
        if (attr === 'dark') return 'dark';
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) return 'dark';
        return 'default';
      };

      let renderCounter = 0;

      const renderAll = async () => {
        const theme = getCurrentTheme();

        // 2. Added 'theme: theme' so it actually switches!
        // 3. Reduced fontSize to 16px to prevent SVG clipping/overflow errors
        mermaid.initialize({
          startOnLoad: false,
          theme: theme,
          securityLevel: 'loose',
          flowchart: {
            htmlLabels: true,
            nodeSpacing: 50,
            rankSpacing: 60,
          },
          themeVariables: {
            fontSize: "24px", 
          },
        });

        for (const wrapper of wrappers) {
          const codeEl = wrapper.querySelector('script[data-mermaid-code]');
          const outputEl = wrapper.querySelector('.mermaid-output');
          
          if (!codeEl || !outputEl) continue;

          const code = codeEl.textContent;
          const id = `mmd-${renderCounter++}-${Date.now()}`;

          try {
            // Clear previous output to prevent duplication on theme switch
            outputEl.innerHTML = '';
            
            const { svg } = await mermaid.render(id, code);
            outputEl.innerHTML = svg;
          } catch (err) {
            console.error('Mermaid render error:', err);
            // Show the actual error on screen so you can debug if it happens again
            outputEl.innerHTML = `<pre style="color: red; font-size: 0.8rem; background: #fee; padding: 1rem; border-radius: 4px;">${err.message}</pre>`;
          }
        }
      };

      // Initial render
      await renderAll();

      // Watch for theme changes and re-render
      const observer = new MutationObserver(() => {
        renderAll();
      });

      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class', 'data-theme'],
      });
    });
  }
</script>