<!-- src/components/home/SkillsRadar.astro -->
<svg viewBox="0 0 200 200" class="w-full max-w-[250px] drop-shadow-2xl">
  <!-- Background Grid -->
  <polygon points="100,20 170,60 170,140 100,180 30,140 30,60" fill="none" stroke="#27272A" stroke-width="1" />
  <polygon points="100,40 150,70 150,130 100,160 50,130 50,70" fill="none" stroke="#27272A" stroke-width="1" />
  <polygon points="100,60 130,80 130,120 100,140 70,120 70,80" fill="none" stroke="#27272A" stroke-width="1" />
  
  <!-- Axes -->
  <line x1="100" y1="100" x2="100" y2="20" stroke="#27272A" stroke-width="1" />
  <line x1="100" y1="100" x2="170" y2="60" stroke="#27272A" stroke-width="1" />
  <line x1="100" y1="100" x2="170" y2="140" stroke="#27272A" stroke-width="1" />
  <line x1="100" y1="100" x2="100" y2="180" stroke="#27272A" stroke-width="1" />
  <line x1="100" y1="100" x2="30" y2="140" stroke="#27272A" stroke-width="1" />
  <line x1="100" y1="100" x2="30" y2="60" stroke="#27272A" stroke-width="1" />

  <!-- Data Polygon (Animated) -->
  <!-- Values: Data Eng(85), Analytics(90), Security(70), Cloud(80), Python(95), dbt(88) -->
  <polygon 
    points="100,35 156,68 156,128 100,152 44,128 44,68" 
    fill="rgba(66, 133, 244, 0.2)" 
    stroke="#4285F4" 
    stroke-width="2"
    class="animate-[pulse_3s_ease-in-out_infinite]"
  />
  
  <!-- Data Points -->
  <circle cx="100" cy="35" r="3" fill="#4285F4" />
  <circle cx="156" cy="68" r="3" fill="#4285F4" />
  <circle cx="156" cy="128" r="3" fill="#4285F4" />
  <circle cx="100" cy="152" r="3" fill="#4285F4" />
  <circle cx="44" cy="128" r="3" fill="#4285F4" />
  <circle cx="44" cy="68" r="3" fill="#4285F4" />

  <!-- Labels -->
  <text x="100" y="12" text-anchor="middle" fill="#A1A1AA" font-size="10" font-family="monospace">Data Eng</text>
  <text x="180" y="58" text-anchor="start" fill="#A1A1AA" font-size="10" font-family="monospace">Analytics</text>
  <text x="180" y="148" text-anchor="start" fill="#A1A1AA" font-size="10" font-family="monospace">Security</text>
  <text x="100" y="195" text-anchor="middle" fill="#A1A1AA" font-size="10" font-family="monospace">Cloud</text>
  <text x="20" y="148" text-anchor="end" fill="#A1A1AA" font-size="10" font-family="monospace">Python</text>
  <text x="20" y="58" text-anchor="end" fill="#A1A1AA" font-size="10" font-family="monospace">dbt/SQL</text>
</svg>

<style>
  @keyframes pulse {
    0%, 100% { opacity: 0.8; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.02); }
  }
</style>