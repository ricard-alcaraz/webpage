---
// src/components/home/TerminalHero.astro
---
<div class="terminal-wrapper group relative w-full max-w-lg mx-auto rounded-xl overflow-hidden border border-white/10 bg-[#0d1117] font-mono text-sm transition-all duration-300 hover:border-accent/50 hover:shadow-[0_0_40px_-10px_rgba(var(--accent-rgb,59,130,246),0.4)]">
  
  <!-- Terminal Header -->
  <div class="flex items-center gap-2 px-4 py-3 bg-white/5 border-b border-white/5">
    <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
    <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
    <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
    <span class="ml-2 text-xs text-gray-200">pipeline_execution.sh</span>
  </div>
  
  <!-- Terminal Body -->
  <div class="p-6 space-y-3 text-gray-300 min-h-[220px]">
    <div class="flex gap-2 items-center">
      <span class="text-green-400">➜</span>
      <span class="text-blue-400">~</span>
      <span id="line-1" class="text-gray-100 opacity-0 transition-all duration-300 translate-x-2">
        dbt run --select staging+
      </span>
    </div>
    
    <div id="line-2" class="text-gray-100 pl-6 text-xs leading-relaxed opacity-0 transition-all duration-500">
      <span class="text-blue-400">12:04:01</span> Running with dbt=1.7.0<br>
      <span class="text-blue-400">12:04:02</span> Found 42 models, 120 tests...
    </div>

    <div id="line-3" class="text-gray-100 pl-6 text-xs leading-relaxed opacity-0 transition-all duration-500">
      <span class="text-blue-400">12:04:15</span> START relation `analytics.stg_payments`<br>
      <span class="text-green-400">12:04:18</span> OK created in 3.2s
    </div>

    <div id="line-4" class="mt-4 pt-4 border-t border-white/5 opacity-0 transition-all duration-500">
      <div class="flex items-center gap-2 text-green-400 font-bold">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        SUCCESS
      </div>
      <div class="text-gray-100 text-xs mt-1">Pipeline orchestrated. Looker dashboards updated.</div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const show = (id, delay) => {
      setTimeout(() => {
        const el = document.getElementById(id);
        if (el) {
          el.classList.remove('opacity-0', 'translate-x-2');
          el.classList.add('opacity-100', 'translate-x-0');
        }
      }, delay);
    };
    show('line-1', 600);
    show('line-2', 1800);
    show('line-3', 3000);
    show('line-4', 4200);
  });
</script>