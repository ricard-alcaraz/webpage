---
import ExperienceItem from "./ExperienceItem.astro";
import Heading from "../ui/Heading.astro";
import { Icon } from "astro-icon/components";

const EXPERIENCE = [
    {
    date: "October 2024 - September 2026",
    title: "Analytics Engineer",
    company: "SEIDOR Opentrends S.L.",
    description:
      "Owned end-to-end analytics projects, from raw data to final Looker dashboards, entirely within GCP. Handled the full pipeline: data modeling, transformation, and delivery of dashboards that stakeholders relied on for decision-making. Worked independently across the stack, balancing technical depth with a clear focus on usability for the end user.",
  },
  {
    date: "July 2024 - October 2024",
    title: "ALM Ops / DevOps",
    company: "SEIDOR Opentrends S.L.",
    description:
      "Supported the team in the implementation of the cloud infrastructure and the automation of the development and deployment processes for CaixaBank Tech.",
  },
  {
    date: "October 2023 - October 2024",
    title: "PMO Consultant",
    company: "SEIDOR Opentrends S.L.",
    description:
      "Owned executive-level reporting for CaixaBank Tech, building the reports and presentations that informed leadership decisions. Automated a manual process that was costing the team unnecessary hours, and led data ingestion into BigQuery to strengthen the reporting foundation. Combined stakeholder management with hands-on technical delivery.",
  },
    {
    date: "April 2021 - July 2022",
    title: "Blockchain Developer",
    company: "Ilimit Comunications S.L.",
    description:
      "Led an R&D team developing a blockchain application under a project funded by CDTI, Spain's public agency for innovation subvention. Beyond technical leadership, I was responsible for producing high-quality documentation to meet the strict standards required for government-funded R&D, ensuring the project stayed compliant and audit-ready throughout. Balanced hands-on team leadership with the rigor demanded by public funding requirements.",
  },
    {
    date: "February 2016 - February 2017",
    title: "IT and Web Development",
    company: "A-Ser Reparapcs",
    description:
      "Developed two small custom websites end to end, working directly with stakeholders to gather requirements and translate them into personalized, functional sites. Alongside development, provided hardware and software technical support, keeping systems running smoothly for the team. A hands-on early role that combined client-facing work with practical technical problem-solving.",
  },
];
---

<section class="py-8 px-8 max-md:py-4 mb-4 scroll-m-16" id="experience">
  <div class="flex flex-col pt-8 max-w-4xl mx-auto">
    <div class="flex gap-4 items-center justify-center">
      <Icon class="text-3xl dark:text-white text-blacktext" name="briefcase" />
      <Heading text="Work" textGradient="Experience" level={2} />
    </div>

    <div class="relative max-md:mt-0 mt-8" aria-label="Professional experience">
      <ol class="relative mt-10">
        {
          EXPERIENCE.map((experience, index) => (
            <li>
              <article
                role="article"
                aria-labelledby={`experience-title-${index}`}
              >
                <div
                  class="flex flex-col gap-2  text-zinc-00 dark:text-zinc-300 md:col-span-3"
                  aria-describedby={`experience-title-${index}`}
                >
                  <ExperienceItem {...experience} />
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
