---
export interface Props {
  allPosts: any[];
  variant?: "compact" | "full";
}

const { allPosts, variant = "full" } = Astro.props;

// Extract all unique tags
const allTags = [...new Set(allPosts.flatMap(post => post.data.tags))].sort();
---

{variant === "compact" ? (
  <div class="flex flex-wrap gap-2">
    {allTags.map(tag => (
      <a 
        href={`/blog/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`} 
        class="text-xs font-mono px-3 py-1.5 rounded-md bg-white/5 dark:bg-white/5 bg-black/5 text-text-secondary border border-white/10 dark:border-white/10 border-black/10 hover:border-accent/40 hover:text-accent transition-colors"
      >
        {tag}
      </a>
    ))}
  </div>
) : (
  <div class="space-y-2">
    {allTags.map(tag => (
      <a 
        href={`/blog/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`} 
        class="block px-4 py-2 rounded-lg bg-white/5 dark:bg-white/5 bg-black/5 text-text-primary border border-white/10 dark:border-white/10 border-black/10 hover:border-accent/40 hover:text-accent transition-colors"
      >
        {tag}
      </a>
    ))}
  </div>
)}