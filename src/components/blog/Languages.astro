---
export interface Props {
  allPosts: any[];
  level?: number;
}

const { allPosts, level = 2 } = Astro.props;

// Extract all unique languages
const allLanguages = [...new Set(allPosts.flatMap(post => post.data.languages || []))].sort();
---

<div class="flex flex-wrap gap-2">
  {allLanguages.map(lang => (
    <a 
      href={`/blog/techs/${lang.toLowerCase()}`} 
      class="text-xs font-mono px-3 py-1.5 rounded-md bg-white/5 dark:bg-white/5 bg-black/5 text-text-secondary border border-white/10 dark:border-white/10 border-black/10 hover:border-accent/40 hover:text-accent transition-colors"
    >
      {lang}
    </a>
  ))}
</div>