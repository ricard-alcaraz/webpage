---
import Heading from "../ui/Heading.astro";

export interface Props {
  allPosts: any[];
  excludeLatest?: boolean;
  currentPostSlug?: string;
  all?: boolean;
}

const { allPosts, excludeLatest = false, currentPostSlug = "", all = false } = Astro.props;

// Sort by date in descending order (newest first)
allPosts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime();
  const dateB = new Date(b.data.pubDate).getTime();
  return dateB - dateA;
});

// Filter posts according to props
let postsToShow = allPosts;

if (currentPostSlug) {
  postsToShow = postsToShow.filter((post) => {
    const postUrl = `/blog/${post.slug}/`;
    const normalizedPostUrl = postUrl.replace(/\/$/, "");
    const normalizedCurrentUrl = currentPostSlug.replace(/\/$/, "");
    return normalizedPostUrl !== normalizedCurrentUrl;
  });
} else if (excludeLatest) {
  postsToShow = postsToShow.slice(1);
}

if (!all) {
  postsToShow = postsToShow.slice(0, 4);
}
---

<section class="py-8 max-lg:px-4 max-md:px-8 max-sm:px-0 max-md:py-4 max-w-4xl mx-auto">


  <div class="flex flex-col gap-4 w-full mx-auto">
    {postsToShow.map((post) => (
      <a
        href={`/blog/${post.slug}/`}
        class="fancy-post-card group block p-5 rounded-xl bg-surface border border-white/10 dark:border-white/10 border-black/10 transition-all duration-300 hover:-translate-y-0.5"
      >
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-2">
          <h2 class="text-lg font-bold group-hover:text-accent transition-colors">{post.data.title}</h2>
          <span class="text-xs font-mono text-text-secondary whitespace-nowrap">
            {new Date(post.data.pubDate).toLocaleDateString()}
          </span>
        </div>
        <p class="text-sm text-text-secondary line-clamp-2 mb-3">{post.data.description}</p>
        <div class="flex flex-wrap gap-2">
          {post.data.tags.slice(0, 3).map((tag: string) => (
            <span class="text-[10px] font-mono uppercase tracking-wider bg-white/5 dark:bg-white/5 bg-black/5 text-text-secondary px-2 py-0.5 rounded border border-white/10 dark:border-white/10 border-black/10">
              {tag}
            </span>
          ))}
        </div>
      </a>
    ))}
  </div>

  {!all && (
    <div id="morePosts" class="w-full flex justify-center text-center my-12">
      <a
        href="/blog/posts/"
        class="font-bold cursor-pointer text-accent hover:text-accent-hover transition-all"
      >
        View all posts...
      </a>
    </div>
  )}
</section>

<script>
  document.querySelectorAll('.fancy-post-card').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      card.style.setProperty('--mouse-x', `${x}px`);
      card.style.setProperty('--mouse-y', `${y}px`);
    });
  });
</script>

<style>
  .fancy-post-card {
    position: relative;
    overflow: hidden;
  }
  .fancy-post-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    border-radius: 0.75rem;
    background: radial-gradient(
      600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(66, 133, 244, 0.06),
      transparent 40%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 0;
  }
  .fancy-post-card:hover::before {
    opacity: 1;
  }
  .fancy-post-card > * {
    position: relative;
    z-index: 1;
  }
</style>