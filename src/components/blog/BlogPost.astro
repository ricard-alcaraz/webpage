---
export interface Props {
  url: string;
  title: string;
  date: Date;
  tags: string[];
  languages?: string[];
  image?: {
    url: string;
    alt: string;
  };
}

const { url, title, date, tags, languages = [], image } = Astro.props;
---

<a href={url} class="group block p-5 rounded-xl bg-surface border border-white/10 dark:border-white/10 border-black/10 hover:border-accent/40 transition-all duration-300 hover:-translate-y-0.5">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-2">
    <h2 class="text-lg font-bold group-hover:text-accent transition-colors">{title}</h2>
    <span class="text-xs font-mono text-text-secondary whitespace-nowrap">{new Date(date).toLocaleDateString()}</span>
  </div>
  <div class="flex flex-wrap gap-2">
    {tags.slice(0, 3).map((tag: string) => (
      <span class="text-[10px] font-mono uppercase tracking-wider bg-white/5 dark:bg-white/5 bg-black/5 text-text-secondary px-2 py-0.5 rounded border border-white/10 dark:border-white/10 border-black/10">
        {tag}
      </span>
    ))}
  </div>
</a>