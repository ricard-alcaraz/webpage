---
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
---

<Layout pageTitle={frontmatter.title} description={frontmatter.description} ogimage={frontmatter.image}>
  <main class="min-h-screen bg-background text-text-primary px-4 py-12 md:px-8 max-w-4xl mx-auto transition-colors duration-300">
    
    <!-- Hero Profile Header -->
    <div class="flex flex-col md:flex-row gap-8 items-center mb-16 p-8 bg-surface border border-white/10 dark:border-white/10 border-black/10 rounded-3xl shadow-lg relative overflow-hidden">
      <div class="absolute -top-10 -right-10 w-40 h-40 bg-accent/10 rounded-full blur-3xl pointer-events-none"></div>
      {frontmatter.image?.url && (
        <img src={frontmatter.image.url} alt={frontmatter.image.alt || frontmatter.title} class="w-32 h-32 md:w-40 md:h-40 rounded-2xl object-cover border-2 border-accent/20 shadow-xl z-10" />
      )}
      <div class="text-center md:text-left z-10">
        <h1 class="text-3xl md:text-4xl font-bold mb-3 text-text-primary">{frontmatter.title}</h1>
        <p class="text-text-secondary text-lg leading-relaxed">{frontmatter.description}</p>
      </div>
    </div>

    <!-- Markdown Content Wrapper -->
    <article class="markdown-about-content">
      <slot />
    </article>

  </main>
</Layout>

<style is:global>
  .markdown-about-content {
    @apply max-w-none text-text-primary leading-relaxed;
  }
  
  /* Override default paragraph styles */
  .markdown-about-content p {
    @apply text-text-secondary mb-6 text-base md:text-lg;
  }

  /* Fancy Section Headings */
  .markdown-about-content h2 {
    @apply text-2xl font-bold mt-16 mb-6 text-text-primary flex items-center gap-4;
  }
  .markdown-about-content h2::before {
    content: '';
    @apply w-1.5 h-6 bg-accent rounded-full inline-block;
  }

  /* Premium Table Styling (For your Certificates) */
  .markdown-about-content table {
    @apply w-full border-collapse bg-surface border border-white/10 dark:border-white/10 border-black/10 rounded-2xl overflow-hidden shadow-lg my-8 block overflow-x-auto;
  }
  .markdown-about-content thead {
    @apply bg-accent/10 text-accent;
  }
  .markdown-about-content th {
    @apply px-6 py-4 text-left text-xs font-mono uppercase tracking-widest border-b border-white/10 dark:border-white/10 border-black/10;
  }
  .markdown-about-content td {
    @apply px-6 py-4 text-text-secondary border-b border-white/5 dark:border-white/5 border-black/5 text-sm;
  }
  .markdown-about-content tr:last-child td {
    @apply border-b-0;
  }
  .markdown-about-content tbody tr {
    @apply hover:bg-accent/5 transition-colors duration-200;
  }
  
  /* "Validate" Links in Table */
  .markdown-about-content td a {
    @apply text-accent font-mono text-xs font-bold hover:underline inline-flex items-center gap-1;
  }

  /* Premium List Styling (For Education) */
  .markdown-about-content ul {
    @apply space-y-4 text-text-secondary list-none p-0;
  }
  .markdown-about-content ul li {
    @apply flex flex-col gap-1 p-5 bg-surface border border-white/10 dark:border-white/10 border-black/10 rounded-xl hover:border-accent/30 transition-colors relative pl-8;
  }
  .markdown-about-content ul li::before {
    content: '🎓';
    @apply absolute left-5 top-5 text-sm opacity-50;
  }
  .markdown-about-content ul li strong {
    @apply text-text-primary text-base font-semibold mb-1;
  }
  .markdown-about-content ul li em {
    @apply text-xs font-mono text-text-secondary;
  }
  
  /* Horizontal Rules */
  .markdown-about-content hr {
    @apply my-16 border-white/10 dark:border-white/10 border-black/10;
  }
</style>